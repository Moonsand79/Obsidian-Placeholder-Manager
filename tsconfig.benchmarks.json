{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": ".benchmark-build",
    "rootDir": ".",
    "inlineSourceMap": false,
    "inlineSources": false,
    "sourceMap": false,
    "isolatedModules": false,
    "noEmit": false,
    "esModuleInterop": true
  },
  "include": [
    "benchmarks/**/*.ts",
    "src/build-flags.d.ts"
  ],
  "exclude": [
    "node_modules",
    ".benchmark-build",
    ".test-build"
  ]
}
